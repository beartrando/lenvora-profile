GRPC_PORT=50051

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/profile
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/profile


JWT_ACCESS_SECRET=your_access_secret

PG_BOSS_MAX=5
PG_BOSS_NEW_CONNECTION_TIMEOUT_SECONDS=30
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=profile-pgboss

KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_PROFILE_CREATED=profile.created
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=profile-client
KAFKA_GROUP_ID=profile-service
